{
  "name": "orbit-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev-orbit.sh",
    "next:dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "search:up": "docker compose -f docker-compose.searxng.yml up -d",
    "search:down": "docker compose -f docker-compose.searxng.yml down",
    "search:logs": "docker compose -f docker-compose.searxng.yml logs -f searxng",
    "search:status": "docker compose -f docker-compose.searxng.yml ps"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
